{
    "name": "okta-react-sample",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "start": "vite --open",
        "build": "vite build",
        "dev": "npm cache clean --force && vite --open",
        "test": "jest",
        "lint": "eslint \"src/**/*.{js,jsx}\"",
        "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
        "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc"
    },
    "dependencies": {
        "@emotion/react": "^11.13.3",
        "@emotion/styled": "^11.13.0",
        "@microsoft/signalr": "^9.0.6",
        "@mui/icons-material": "^5.16.6",
        "@mui/lab": "^5.0.0-alpha.173",
        "@mui/material": "^5.16.7",
        "@mui/x-data-grid": "^7.23.5",
        "@mui/x-date-pickers": "^6.20.2",
        "@okta/okta-auth-js": "6.6.1",
        "@okta/okta-react": "^6.4.3",
        "@reduxjs/toolkit": "^1.8.4",
        "axios": "^1.7.7",
        "colors": "1.4.0",
        "file-saver": "^2.0.5",
        "moment": "^2.30.1",
        "rc-tree": "^5.13.1",
        "react": "^17.0.2",
        "react-dnd": "^11.1.3",
        "react-dom": "^17.0.2",
        "react-redux": "^8.0.2",
        "react-router-dom": "^5.3.0",
        "react-select": "^5.10.1",
        "react-toastify": "^8.1.0",
        "redux": "^4.2.1"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.18.2",
        "@babel/preset-react": "^7.17.12",
        "@testing-library/jest-dom": "^5.16.4",
        "@testing-library/react": "^12.1.3",
        "@testing-library/user-event": "^14.2.0",
        "@vitejs/plugin-react": "^1.3.2",
        "dotenv": "^16.0.1",
        "eslint": "^8.21.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-prettier": "^4.2.1",
        "jest": "^28.1.0",
        "jest-environment-jsdom": "^28.1.0",
        "prettier": "^2.7.1",
        "rollup-plugin-visualizer": "^5.14.0",
        "vite": "^6.0.7"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged && CI=true npm run test"
        }
    },
    "lint-staged": {
        "*.{js,jsx}": [
            "prettier --write",
            "eslint --fix",
            "git add"
        ],
        "*.{html,css,less,ejs}": [
            "prettier --write",
            "git add"
        ]
    },
    "jest": {
        "testEnvironment": "jsdom",
        "moduleNameMapper": {
            "^@okta/okta-auth-js$": "<rootDir>/node_modules/@okta/okta-auth-js/dist/okta-auth-js.umd.js",
            "\\.(css|less)$": "<rootDir>/test/jest/__mocks__/styleMock.js"
        },
        "setupFiles": [
            "<rootDir>/jest.setup.js"
        ]
    }
}
